#!/bin/sh
# Refuse a push whose destination is main. The ruleset is the real gate; this
# makes the mistake visible before the push leaves the machine. Install it with
# `just hooks`. See the owner standard's branch model.
#
# Git calls the hook with the remote name and URL, then one line per ref on
# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>.

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/main)
      echo "pre-push: main takes a pull request; refusing $remote_ref to $1" >&2
      status=1
      ;;
  esac
done

exit "$status"
